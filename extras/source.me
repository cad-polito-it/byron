dir=$PWD
n=0
while [[ ! -f "${dir}/byron/__init__.py" ]]; do
  [[ "$(realpath "$dir")" == "/" ]] && break
  dir="$(realpath "${dir}/..")"
done
[[ -f "${dir}/byron/__init__.py" ]] && export PYTHONPATH="${PYTHONPATH}:${dir}"

echo "export PYTHONPATH=\"${PYTHONPATH}\""
echo "#export PYTHONOPTIMIZE=1"
